<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#10172a">
<title>Happy Birthday, Don R. Dy! 🎉</title>
<style>
:root{--night:#10172a;--cream:#fff8eb;--gold:#ffd477;--coral:#ff806d;--lav:#b7a6ff;--mint:#9ee5cb}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--night);color:var(--cream);font-family:Georgia,'Times New Roman',serif;overflow-x:hidden}
button{font:inherit;cursor:pointer}.hero{min-height:100svh;display:grid;place-items:center;text-align:center;padding:70px 22px;position:relative;isolation:isolate;background:radial-gradient(ellipse at 50% 20%,#303c61 0%,#18233d 42%,#10172a 78%)}
.hero:before,.hero:after{content:"";position:absolute;border:1px solid #ffffff18;border-radius:50%;width:min(80vw,650px);aspect-ratio:1;z-index:-1;animation:orbit 28s linear infinite}.hero:after{width:min(65vw,500px);animation-direction:reverse}
@keyframes orbit{to{transform:rotate(360deg)}}.eyebrow{letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font:600 11px Arial,sans-serif}
h1{font-size:clamp(3.6rem,12vw,8.5rem);line-height:.88;margin:24px 0 18px;font-weight:500;letter-spacing:-.065em}.hero h1 span{display:block;color:var(--gold);font-style:italic}
.sub{font:16px/1.7 Arial,sans-serif;color:#d4d8e5;max-width:520px;margin:0 auto 30px}.cta{border:0;border-radius:999px;background:var(--gold);color:#20243a;padding:15px 25px;font:bold 13px Arial,sans-serif;letter-spacing:.06em;box-shadow:0 8px 30px #ffd47730;transition:.2s}.cta:hover{transform:translateY(-3px);box-shadow:0 12px 36px #ffd47755}
.scroll{position:absolute;bottom:24px;font:10px Arial,sans-serif;letter-spacing:.2em;color:#aeb8ce}
.spark{position:absolute;font-size:clamp(18px,3vw,32px);animation:float 5s ease-in-out infinite}.s1{top:17%;left:13%}.s2{top:25%;right:13%;animation-delay:1s}.s3{bottom:20%;left:18%;animation-delay:2s}.s4{bottom:25%;right:17%;animation-delay:3s}@keyframes float{50%{transform:translateY(-18px) rotate(12deg)}}
section{padding:100px 22px}.wrap{max-width:1050px;margin:auto}.section-tag{font:11px Arial,sans-serif;letter-spacing:.24em;color:var(--coral);text-transform:uppercase}h2{font-size:clamp(2.5rem,7vw,5rem);font-weight:500;letter-spacing:-.05em;line-height:1;margin:15px 0 24px}.intro{font:16px/1.8 Arial,sans-serif;color:#c6ccda;max-width:680px}
.message{background:var(--cream);color:#222943;border-radius:28px;padding:clamp(28px,6vw,65px);margin-top:35px;position:relative;overflow:hidden}.message:after{content:"✦";position:absolute;right:25px;top:10px;font-size:100px;color:#f1e5d0}.message p{font-size:clamp(1.15rem,2.5vw,1.5rem);line-height:1.8;max-width:750px;position:relative;z-index:1}.signature{color:#a15c4e;font-style:italic;font-size:1.5rem}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:38px}.tile{background:#1b2742;border:1px solid #ffffff12;border-radius:22px;padding:28px;min-height:190px;transition:.25s}.tile:hover{transform:translateY(-6px);background:#243252}.tile .emoji{font-size:30px}.tile h3{font-size:1.4rem;font-weight:500;margin:18px 0 8px}.tile p{font:14px/1.7 Arial,sans-serif;color:#bdc6d8;margin:0}
.gallery{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:14px;margin-top:35px}.photo{min-height:210px;border:1px dashed #687695;border-radius:20px;display:grid;place-items:center;text-align:center;padding:18px;background:linear-gradient(145deg,#202d4b,#172139);color:#cbd2e0;font:13px/1.6 Arial,sans-serif;position:relative;overflow:hidden}.photo input{position:absolute;inset:0;opacity:0;cursor:pointer}.photo img{position:absolute;width:100%;height:100%;object-fit:cover;inset:0}.photo strong{font-size:28px;display:block;margin-bottom:8px}
.gift-area{text-align:center;background:linear-gradient(160deg,#202d4b,#151e34)}.gift{width:160px;height:130px;margin:35px auto 22px;position:relative;cursor:pointer;transition:.3s}.gift:hover{transform:translateY(-7px) rotate(-2deg)}.box{position:absolute;bottom:0;width:160px;height:100px;background:var(--coral);border-radius:8px}.lid{position:absolute;top:15px;left:-8px;width:176px;height:28px;background:#ffad91;border-radius:7px;transition:.5s;z-index:2}.ribbon{position:absolute;left:68px;bottom:0;width:24px;height:100px;background:var(--gold);z-index:1}.bow{position:absolute;top:-7px;left:62px;font-size:45px;color:var(--gold);z-index:3}.gift.open .lid{transform:translateY(-55px) rotate(-12deg)}.gift-note{max-width:520px;margin:20px auto 0;font:15px/1.8 Arial,sans-serif;color:#cbd2e0;min-height:55px}
.wish-form{display:flex;gap:10px;max-width:650px;margin:30px auto 0}.wish-form input{flex:1;min-width:0;border:1px solid #ffffff2b;border-radius:999px;background:#ffffff0b;color:white;padding:15px 18px;font:14px Arial,sans-serif}.wish-form button{border:0;border-radius:999px;padding:0 20px;background:var(--mint);color:#142239;font:bold 12px Arial,sans-serif}.wishes{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:22px}.wish{background:#ffffff12;border:1px solid #ffffff18;padding:10px 15px;border-radius:30px;font:13px Arial,sans-serif}
footer{text-align:center;padding:35px 20px 55px;color:#8995ad;font:12px Arial,sans-serif}footer span{color:var(--gold)}
#toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);background:var(--cream);color:#20243a;padding:12px 18px;border-radius:30px;font:13px Arial,sans-serif;opacity:0;transition:.3s;pointer-events:none;z-index:10}#toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:700px){.grid{grid-template-columns:1fr}.tile{min-height:auto}.gallery{grid-template-columns:1fr 1fr}.photo:first-child{grid-column:span 2;min-height:230px}.wish-form{flex-direction:column}.wish-form button{padding:15px}.hero:before{width:95vw}.hero:after{width:75vw}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header class="hero" id="top">
  <div class="spark s1">✦</div><div class="spark s2">✧</div><div class="spark s3">★</div><div class="spark s4">✦</div>
  <div>
    <div class="eyebrow">A birthday tribute from Bien L. Dy</div>
    <h1>Happy Birthday,<span>Dad!</span></h1>
    <p class="sub">Today is all about celebrating you — your big heart, your quiet strength, and all the little things you do that mean the world.</p>
    <button class="cta" onclick="document.querySelector('#letter').scrollIntoView({behavior:'smooth'})">OPEN YOUR BIRTHDAY SURPRISE ↓</button>
  </div>
  <div class="scroll">SCROLL TO CELEBRATE · ↓</div>
</header>
<main>
<section id="letter">
 <div class="wrap">
  <div class="section-tag">A letter from the heart</div>
  <h2>For my first<br><em>everyday hero.</em></h2>
  <p class="intro">Some things are too important to fit into an ordinary birthday greeting. So here's a little space dedicated just to you.</p>
  <div class="message">
   <p>Dear Dad,<br><br>Thank you for every sacrifice, every lesson, every laugh, and every time you've been there for me. I may not say it every day, but I notice the things you do and I appreciate you more than words can explain.<br><br>I hope this new year of your life brings you good health, peaceful days, genuine happiness, and all the love you deserve. May you always have reasons to smile and moments that remind you how much you mean to us.<br><br>I'm so lucky to have you as my dad. I love you. Happy birthday!</p>
   <div class="signature">With all my love,<br>Bien L. Dy ♡</div>
  </div>
 </div>
</section>
<section style="background:#151e34">
 <div class="wrap">
  <div class="section-tag">The things that make you, you</div><h2>Three reasons<br>you're the best.</h2>
  <div class="grid">
   <article class="tile"><div class="emoji">🛡️</div><h3>Your strength</h3><p>You keep showing up, even when things aren't easy. That means more than you know.</p></article>
   <article class="tile"><div class="emoji">☀️</div><h3>Your heart</h3><p>Your care, kindness, and the way you look after the people you love make life brighter.</p></article>
   <article class="tile"><div class="emoji">😂</div><h3>Your humor</h3><p>For the jokes, the stories, and the moments that turn an ordinary day into a good memory.</p></article>
  </div>
 </div>
</section>

<section class="gift-area">
 <div class="wrap">
  <div class="section-tag">One more little surprise</div><h2>Your gift is<br>waiting, Dad.</h2>
  <p class="intro" style="margin:auto">There's no wrapping paper big enough for how much you're appreciated. But here's a tiny virtual present.</p>
  <div class="gift" role="button" tabindex="0" aria-label="Open birthday gift" onclick="openGift()" onkeydown="if(event.key==='Enter'||event.key===' ')openGift()">
   <div class="lid"></div><div class="bow">♧</div><div class="box"></div><div class="ribbon"></div>
  </div>
  <button class="cta" onclick="openGift()">TAP TO OPEN YOUR GIFT</button>
  <p class="gift-note" id="giftNote">A little surprise is tucked inside. Go on — open it! 🎁</p>
 </div>
</section>
<section>
 <div class="wrap" style="text-align:center">
  <div class="section-tag">Add your own words</div><h2>Leave Dad<br>a birthday wish.</h2>
  <p class="intro" style="margin:auto">Write a little message and add it to the birthday wish wall.</p>
  <form class="wish-form" onsubmit="addWish(event)"><input id="wishInput" maxlength="100" placeholder="Write a birthday wish…" aria-label="Birthday wish" required><button type="submit">ADD MY WISH ✦</button></form>
  <div class="wishes" id="wishes"><span class="wish">We love you, Dad! ❤️</span><span class="wish">Best dad, best day! 🎂</span></div>
 </div>
</section>
</main>
<footer>MADE WITH <span>♥</span> BY BIEN L. DY FOR DON R. DY · HAPPY BIRTHDAY, DAD!</footer>
<div id="toast" role="status"></div>
<script>
let giftOpened=false;
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}
function openGift(){const g=document.querySelector('.gift');g.classList.add('open');if(!giftOpened){document.getElementById('giftNote').textContent='Your real gift is this: a whole lot of love, endless gratitude, and a family that is cheering you on today and always. You deserve the world, Dad. ❤️';giftOpened=true;confetti();}}
function addWish(e){e.preventDefault();const input=document.getElementById('wishInput');const value=input.value.trim();if(!value)return;const el=document.createElement('span');el.className='wish';el.textContent=value;document.getElementById('wishes').appendChild(el);input.value='';toast('Your wish has been added! ✨')}
function confetti(){const symbols=['✦','★','🎉','✨','♥'];for(let i=0;i<65;i++){const p=document.createElement('span');p.textContent=symbols[Math.floor(Math.random()*symbols.length)];p.style.cssText=`position:fixed;z-index:20;left:${Math.random()*100}vw;top:-30px;font-size:${12+Math.random()*18}px;pointer-events:none;transition:transform ${2+Math.random()*2}s ease,opacity 3s;`;document.body.appendChild(p);requestAnimationFrame(()=>{p.style.transform=`translate(${(Math.random()-.5)*180}px,${innerHeight+80}px) rotate(${Math.random()*700}deg)`;p.style.opacity='0'});setTimeout(()=>p.remove(),4200)}}
</script>
</body></html>
